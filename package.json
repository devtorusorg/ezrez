{
  "name": "ezrez-monorepo",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "format": "bun run --filter @devtorusorg/ezrez format",
    "format:check": "bun run --filter @devtorusorg/ezrez format:check",
    "lint": "bun run --filter @devtorusorg/ezrez lint",
    "docs:dev": "bun run --filter @devtorusorg/ezrez-docs dev",
    "docs:build": "bun run --filter @devtorusorg/ezrez-docs build",
    "docs:preview": "bun run --filter @devtorusorg/ezrez-docs preview"
  }
}
